# MongoDB connection string (local or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/material-tracker)
MONGODB_URI=mongodb://127.0.0.1:27017/material-tracker
# Random string, at least 32 characters, used to sign session cookies
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Display currency / number locale
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_LOCALE=en-IN